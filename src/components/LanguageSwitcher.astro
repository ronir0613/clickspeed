<div class="language-switcher">
  <label class="sr-only" for="site-language">Language</label>
  <select id="site-language" aria-label="Language">
    <option value="en">English</option>
    <option value="es">Español</option>
    <option value="pt">Português</option>
    <option value="fr">Français</option>
    <option value="id">Bahasa Indonesia</option>
    <option value="de">Deutsch</option>
    <option value="hi">हिन्दी</option>
  </select>
</div>

<style>
  .language-switcher {
    position: fixed;
    z-index: 100;
    top: 12px;
    right: max(12px, calc((100vw - var(--max-w)) / 2 + 12px));
  }

  select {
    min-height: 36px;
    max-width: 170px;
    padding: 6px 28px 6px 10px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    color: var(--text);
    font: 600 0.75rem var(--font-mono);
    cursor: pointer;
  }

  :global(body:has(.home-header) .home-nav) { margin-right: 180px; }
  :global(body:has(.console-root) .console-tele) { padding-top: 56px; }

  @media (max-width: 640px) {
