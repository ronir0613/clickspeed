    :global(body:has(.home-header) .home-nav) { display: none; }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    :global(body:has(.home-header) .home-nav) { margin-right: 180px; }
  }

  @media (max-width: 1024px) {
    :global(body:has(.console-root) .language-switcher) { top: 52px; }
    :global(body:has(.console-root) .console-tele) { padding-top: 12px; }
