---
import Base from '../layouts/Base.astro';
import SiteFooter from './SiteFooter.astro';
import { SITE } from '../config/site';

export interface Props {
  title: string;
  description: string;
  eyebrow: string;
  summary: string;
  updated?: string;
}

const { title, description, eyebrow, summary, updated } = Astro.props;
---

<Base title={`${title} — ${SITE.name}`} description={description}>
  <main class="content-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">← Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <header class="content-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      {updated && <p class="updated">LAST UPDATED <span>·</span> {updated}</p>}
    </header>

    <article class="content-body"><slot /></article>
  </main>
  <SiteFooter />
</Base>

<style>
  .content-page {
    width: calc(100% - var(--gutter) - var(--gutter));
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(28px, 6vw, 64px) 0 24px;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(28px, 5vw, 48px);
    color: var(--faint);
    font: 0.68rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .breadcrumb a { color: var(--dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .content-header {
    padding: 0 0 32px;
    border-bottom: 1px solid var(--line-strong);
  }
  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent);
    font: 600 0.68rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: var(--text);
    font: 700 clamp(2rem, 5vw, 3.25rem)/1.08 var(--font-head);
    letter-spacing: -0.035em;
  }
  .summary {
    max-width: 680px;
    margin: 16px 0 0;
    color: var(--dim);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .updated {
    margin: 20px 0 0;
    color: var(--faint);
    font: 0.62rem var(--font-mono);
    letter-spacing: 0.12em;
  }
  .updated span { color: var(--accent); }
  .content-body { padding-top: 8px; }
  :global(.content-body section) {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  :global(.content-body h2) {
    margin: 0 0 10px;
    color: var(--text);
    font: 700 1rem var(--font-head);
    letter-spacing: 0.035em;
  }
  :global(.content-body h3) {
    margin: 18px 0 8px;
    color: var(--text);
    font: 600 0.85rem var(--font-head);
  }
  :global(.content-body p), :global(.content-body li) {
    color: var(--dim);
    font-size: 0.94rem;
    line-height: 1.75;
  }
  :global(.content-body p) { margin: 0 0 12px; }
  :global(.content-body p:last-child) { margin-bottom: 0; }
  :global(.content-body ul) { margin: 10px 0 0; padding-left: 1.2rem; }
  :global(.content-body li + li) { margin-top: 7px; }
  :global(.content-body a) { color: var(--accent); text-underline-offset: 3px; }
  :global(.content-body strong) { color: var(--text); font-weight: 600; }
  :global(.contact-card) {
    margin-top: 18px;
    padding: clamp(18px, 4vw, 28px);
    border: 1px solid var(--line-strong);
    background: var(--panel);
  }
  :global(.contact-card a) {
    display: inline-block;
    margin-top: 6px;
    font: 600 clamp(1rem, 3vw, 1.25rem) var(--font-mono);
    overflow-wrap: anywhere;
  }
  @media (max-width: 480px) {
    .summary { font-size: 0.95rem; }
    :global(.content-body p), :global(.content-body li) { font-size: 0.9rem; }
  }
</style>
