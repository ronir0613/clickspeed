---
import TestLayout from '../layouts/TestLayout.astro';
import ReactionTest from '../islands/ReactionTest';
import OtherTests from '../components/OtherTests.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config/site';
import { TEST_CONFIGS } from '../config/tests';

const cfg = TEST_CONFIGS['reaction-time-test'];
const canonicalUrl = `${SITE.url}/reaction-time-test`;

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: cfg.title,
  url: canonicalUrl,
  description: cfg.metaDescription,
  applicationCategory: 'Game',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the average human reaction time?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The average human visual reaction time is approximately 250–300 ms. Professional gamers typically average 200–250 ms. Anything below 200 ms is exceptional; below 150 ms is at the edge of human physiology.',
      },
    },
    {
      '@type': 'Question',
      name: 'What counts as a fault?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Clicking before the arena turns green (before the GO signal) counts as a fault. The round resets and you must complete it again. This prevents "jump starting" which would give artificially fast times.',
      },
    },
  ],
};
---

<TestLayout
  title={cfg.title}
  description={cfg.metaDescription}
  canonical={canonicalUrl}
  currentSlug="reaction-time-test"
  jsonLd={[webAppLd, faqLd]}
>
  <div slot="arena" style="height:100%; display:flex; flex-direction:column;">
    <ReactionTest client:load />
  </div>
  <div slot="telemetry" style="height:100%;--accent:#39e079;">
    <div class="section-label">REACTION TIERS</div>
    <div style="display:flex;flex-direction:column;gap:4px;margin-top:8px;">
      {[
        ['INHUMAN',  '< 150 ms'],
        ['ELITE',    '150 – 200 ms'],
        ['FAST',     '200 – 280 ms'],
        ['AVERAGE',  '280 – 400 ms'],
        ['SLOW',     '400+ ms'],
      ].map(([tier, range]) => (
        <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 6px;border-bottom:1px solid var(--line);">
          <span style="font-family:var(--font-head);font-size:0.65rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--accent);">{tier}</span>
          <span style="font-family:var(--font-mono);font-size:0.7rem;color:var(--dim);">{range}</span>
        </div>
      ))}
    </div>
    <div class="section-label" style="margin-top:16px;">TIPS</div>
    <ul style="margin-top:8px;padding-left:16px;font-size:0.8rem;color:var(--dim);line-height:1.8;">
      <li>Maintain focus — don't blink at GO</li>
      <li>Keep your finger resting on the button</li>
      <li>5 rounds average is more reliable than any single round</li>
      <li>Monitor latency can add 10–20ms; use a 144Hz+ display for best results</li>
    </ul>
  </div>

  <div slot="seo" style="--accent:#39e079;">
    <nav aria-label="Breadcrumb">
      <ol style="display:flex;gap:8px;list-style:none;font-size:0.75rem;color:var(--faint);font-family:var(--font-mono);">
        <li><a href="/" style="color:var(--dim);">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Reaction Time Test</li>
      </ol>
    </nav>
    <h2 style="font-size:1.25rem;margin-top:24px;margin-bottom:12px;">{cfg.copyHeadline}</h2>
    <p>Reaction time is the interval between a stimulus appearing and your response to it. Our test measures <em>visual-motor reaction time</em> — from the moment the arena turns green to the moment you click. The test uses <code>performance.now()</code> with sub-millisecond resolution, making it far more accurate than simple <code>Date.now()</code> implementations.</p>
    <p style="margin-top:12px;">Each session runs five rounds. Clicking before the GO signal counts as a fault and the round restarts — this prevents pre-clicking strategies that would inflate your score. Your final result is the average of all five valid rounds, plus your single best round.</p>

    <h3 style="margin-top:24px;margin-bottom:8px;">Reaction Time Reference Table</h3>
    <table style="width:100%;border-collapse:collapse;font-size:0.875rem;font-family:var(--font-mono);">
      <thead>
        <tr style="border-bottom:1px solid var(--line-strong);">
          <th style="text-align:left;padding:6px 12px 6px 0;color:var(--faint);">TIER</th>
          <th style="text-align:left;padding:6px 12px;color:var(--faint);">AVG REACTION</th>
          <th style="text-align:left;padding:6px 0;color:var(--faint);">WHO?</th>
        </tr>
      </thead>
      <tbody>
        {[
          ['INHUMAN',  '< 150 ms',     'Physiological edge, rare'],
          ['ELITE',    '150–200 ms',   'Pro gamers, athletes'],
          ['FAST',     '200–280 ms',   'Active competitive players'],
          ['AVERAGE',  '280–400 ms',   'Most adults'],
          ['SLOW',     '400+ ms',      'Fatigued or distracted'],
        ].map(([tier, ms, who]) => (
          <tr style="border-bottom:1px solid var(--line);">
            <td style="padding:6px 12px 6px 0;color:var(--accent);">{tier}</td>
            <td style="padding:6px 12px;color:var(--text);">{ms}</td>
            <td style="padding:6px 0;color:var(--dim);">{who}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <OtherTests currentSlug="reaction-time-test" />
    <SiteFooter />
  </div>
</TestLayout>
