---
import TestLayout from '../layouts/TestLayout.astro';
import CpsTest from '../islands/CpsTest';
import OtherTests from '../components/OtherTests.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config/site';
import { TEST_CONFIGS } from '../config/tests';

const cfg = TEST_CONFIGS['butterfly-click-test'];
const canonicalUrl = `${SITE.url}/butterfly-click-test`;
---

<TestLayout
  title={cfg.title}
  description={cfg.metaDescription}
  canonical={canonicalUrl}
  currentSlug="butterfly-click-test"
>
  <div slot="arena" style="height:100%; display:flex; flex-direction:column;">
    <CpsTest
      client:load
      inputType="click"
      duration={5}
      ctaLabel="CLICK TO START BUTTERFLY TEST"
      testId="butterfly-click-test"
    />
  </div>
  <div slot="telemetry" id="telemetry-mount" style="height:100%;"></div>

  <div slot="seo">
    <nav aria-label="Breadcrumb">
      <ol style="display:flex;gap:8px;list-style:none;font-size:0.75rem;color:var(--faint);font-family:var(--font-mono);">
        <li><a href="/" style="color:var(--dim);">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Butterfly Click Test</li>
      </ol>
    </nav>
    <h2 style="font-size:1.25rem;margin-top:24px;margin-bottom:12px;">{cfg.copyHeadline}</h2>
    <p>Butterfly clicking uses two fingers — typically the index and middle finger — alternating rapidly on the same mouse button. By alternating the pressure of two fingers you can achieve click rates well beyond what a single finger can produce, often 15–25 CPS. The technique is popular in Minecraft Bedrock edition PvP.</p>
    <p style="margin-top:12px;">Our test measures raw click rate regardless of technique. The consistency graph in the telemetry panel will show whether your alternating pattern is even (good butterfly technique) or spiked (still developing).</p>
    <OtherTests currentSlug="butterfly-click-test" />
    <SiteFooter />
  </div>
</TestLayout>
