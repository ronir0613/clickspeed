---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config/site';
---

<Base title={`About — ${SITE.name}`} description={`About ${SITE.name}: free, precise browser-based click-speed and reflex testing tools. No accounts, no data collection, fully client-side.`}>
  <div style="max-width:760px;margin:0 auto;padding:48px 16px;">
    <nav aria-label="Breadcrumb" style="margin-bottom:24px;">
      <a href="/" style="font-family:var(--font-mono);font-size:0.75rem;color:var(--dim);">← Home</a>
    </nav>
    <h1>About ClickSPEED.gg</h1>
    <p style="margin-top:16px;">ClickSPEED.gg is a collection of free, browser-based precision instruments for measuring click speed, reaction time, and aim accuracy. Every test runs entirely in your browser — no server, no account, no data upload.</p>
    <h2 style="margin-top:32px;font-size:1rem;">Our Philosophy</h2>
    <p style="margin-top:8px;">We believe performance tools should be as precise as the people using them. That means <code>performance.now()</code> timing (not <code>Date.now()</code>), timer start on first input (not on page load), and honest anti-cheat (no key auto-repeat on spacebar, fault detection on reaction test).</p>
    <h2 style="margin-top:32px;font-size:1rem;">Privacy</h2>
    <p style="margin-top:8px;">Your scores stay in your browser's localStorage. We do not send any data to a server. See our <a href="/privacy">Privacy Policy</a>.</p>
    <h2 style="margin-top:32px;font-size:1rem;">Contact</h2>
    <p style="margin-top:8px;">Have a bug report or suggestion? See the <a href="/contact">contact page</a>.</p>
  </div>
  <SiteFooter />
</Base>
